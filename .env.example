# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public, row-level security applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and DB tests.
# Local default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Root host of the platform, e.g. localhost:3000. Tenant hosts resolve against it.
PLATFORM_HOST=
# Base64 32-byte key that encrypts per-tenant provider secrets. Server only.
TENANT_SECRETS_KEY=
